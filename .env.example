# ==============================================================
# Assudani WA Manager - Environment Configuration Template
# ==============================================================

# Server Configuration
PORT=5001
NODE_ENV=development
BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Meta WhatsApp Cloud API Credentials (API Mode)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v17.0
WEBHOOK_VERIFY_TOKEN=assudani_verify_token_2026

# JWT Authentication Secret
JWT_SECRET=assudani_wa_manager_jwt_secret_2026

# External Integration API Key (QR Mode External Projects)
QR_API_KEY=assudani_qr_external_key_2026

# Redis / Queue Configuration (Optional)
USE_REDIS=false
REDIS_URL=redis://localhost:6379

